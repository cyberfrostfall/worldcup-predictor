# ───────────────────────────────────────────────
# 赛事数据源：football-data.org（免费档支持世界杯）
# 注册获取 key：https://www.football-data.org/client/register
# ───────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=your_football_data_token

# 世界杯赛事代号（football-data.org 中世界杯为 WC）
COMPETITION_CODE=WC

# ───────────────────────────────────────────────
# 大模型（预测）：任意 OpenAI 兼容接口，可自定义
#   - 官方 OpenAI:  https://api.openai.com/v1
#   - DeepSeek:     https://api.deepseek.com/v1
#   - 本地/中转:     http://127.0.0.1:8000/v1  等
# 只要服务实现了 /chat/completions，改这三个变量即可，无需改代码
# ───────────────────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o

# 触发同步/预测接口的保护令牌（Cron 调用时带上，防止被随意触发）
CRON_SECRET=change_me_to_a_random_string
